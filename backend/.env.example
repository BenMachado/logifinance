# LogiFinance Backend — example env file (copy to .env)
PROJECT_NAME="LogiFinance API"
API_V1_PREFIX="/api/v1"

DATABASE_URL="postgresql+asyncpg://logifinance:logifinance@localhost:5432/logifinance"

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-in-production-please-32-bytes-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

STORAGE_DIR="./storage"
MARGIN_ALERT_THRESHOLD=0.20
TESSERACT_LANG="por+eng"
